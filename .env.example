# ── Modo servidor (docker compose) ─────────────────────────────
# Cada pessoa entra com a própria conta: a primeira conta criada administra a instalação.
# Endereço público do tuesday — só se houver domínio/proxy na frente (ou login com o Google).
# Acessando direto pelo IP da máquina na rede, deixe comentado.
# TUESDAY_URL=https://tuesday.seudominio.com
# Senha do usuário "tuesday" no PostgreSQL do compose.
POSTGRES_PASSWORD=troque-esta-senha
# Porta publicada no servidor.
TUESDAY_PORT=4010

# Login com o Google (opcional): o botão aparece na tela de entrada quando os dois estão definidos.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Rodando pelo código (npm start) com PostgreSQL próprio ─────
# TUESDAY_DATABASE_URL=postgres://tuesday:senha@localhost:5432/tuesday
# HOST=0.0.0.0
