# ── Modo servidor (docker compose) ─────────────────────────────
# Senha para entrar no tuesday (o navegador pede na primeira visita; qualquer usuário serve).
TUESDAY_PASSWORD=troque-esta-senha
# Senha do usuário "tuesday" no PostgreSQL do compose.
POSTGRES_PASSWORD=troque-esta-tambem
# Porta publicada no servidor.
TUESDAY_PORT=4010

# ── Rodando pelo código (npm start) com PostgreSQL próprio ─────
# TUESDAY_DATABASE_URL=postgres://tuesday:senha@localhost:5432/tuesday
# HOST=0.0.0.0
