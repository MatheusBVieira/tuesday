{
  "name": "tuesday",
  "version": "1.0.0",
  "description": "Gestão de tarefas open source no estilo monday.com, feita para trabalhar junto com o Claude: tabela, Kanban, subitens, Git e servidor MCP. Local com SQLite ou em servidor com PostgreSQL.",
  "license": "MIT",
  "author": "Matheus Bruggemann Vieira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusBVieira/tuesday.git"
  },
  "homepage": "https://github.com/MatheusBVieira/tuesday#readme",
  "bugs": {
    "url": "https://github.com/MatheusBVieira/tuesday/issues"
  },
  "keywords": [
    "kanban",
    "tarefas",
    "monday",
    "mcp",
    "claude",
    "claude-code",
    "sqlite",
    "postgres"
  ],
  "type": "module",
  "private": true,
  "bin": {
    "tuesday": "bin/tuesday.mjs",
    "tuesday-mcp": "bin/tuesday-mcp.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "mcp": "node bin/tuesday-mcp.mjs",
    "setup": "node bin/tuesday.mjs setup",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "npm run test:mcp && npm run test:hooks",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:hooks": "node scripts/hooks-smoke.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:up": "docker compose -f compose.dev.yaml -p tuesday-dev up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml -p tuesday-dev down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:icone": "node electron/icone.mjs",
    "desktop:montar": "node electron/build.mjs",
    "desktop:testar": "node electron/build.mjs && electron-builder --win dir",
    "desktop:instalador": "node electron/build.mjs && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
